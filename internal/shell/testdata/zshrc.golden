=== env ===
KUBECONFIG=/tmp/kubie-test/kubeconfig
KON_ACTIVE=1
KON_DEPTH=4
KON_KUBECONFIG=/tmp/kubie-test/kubeconfig
KON_KUBE_CONFIG=/tmp/kubie-test/kubeconfig
KON_SESSION=/tmp/kubie-test/session.json
KON_STATE=/tmp/kubie-test/state.json
KON_PROMPT_DISABLE=0
KON_ZSH_USE_RPS1=0
KON_FISH_USE_RPROMPT=0
KON_XONSH_USE_RIGHT_PROMPT=0
KON_SHELL=zsh
KUBIE_ACTIVE=1
KUBIE_DEPTH=4
KUBIE_KUBECONFIG=/tmp/kubie-test/kubeconfig
KUBIE_SESSION=/tmp/kubie-test/session.json
KUBIE_STATE=/tmp/kubie-test/state.json
KUBIE_PROMPT_DISABLE=0
KUBIE_ZSH_USE_RPS1=0
KUBIE_FISH_USE_RPROMPT=0
KUBIE_XONSH_USE_RIGHT_PROMPT=0
KUBIE_SHELL=zsh
=== rc ===

# Reference for loading behavior
# https://shreevatsa.wordpress.com/2008/03/30/zshbash-startup-files-loading-order-bashrc-zshrc-etc/

if [[ -f "/etc/zshenv" ]] ; then
    source "/etc/zshenv"
elif [[ -f "/etc/zsh/zshenv" ]] ; then
    source "/etc/zsh/zshenv"
fi

if [[ -f "$HOME/.zshenv" ]] ; then
    tmp_ZDOTDIR=$ZDOTDIR
    source "$HOME/.zshenv"
    # If the user has overridden $ZDOTDIR, we save that in $_KON_USER_ZDOTDIR for later reference
    # and reset $ZDOTDIR
    if [[ "$tmp_ZDOTDIR" != "$ZDOTDIR" ]]; then
        _KON_USER_ZDOTDIR=$ZDOTDIR
        ZDOTDIR=$tmp_ZDOTDIR
        unset tmp_ZDOTDIR
    fi
fi

# If a zsh_history file exists, copy it over before zsh initialization so history is maintained
if [[ -f "$HOME/.zsh_history" ]] ; then
    cp $HOME/.zsh_history $ZDOTDIR
fi

KON_LOGIN_SHELL=0
if [[ "$OSTYPE" == "darwin"* ]] ; then
    KON_LOGIN_SHELL=1
fi

if [[ -f "/etc/zprofile" && "$KON_LOGIN_SHELL" == "1" ]] ; then
    source "/etc/zprofile"
elif [[ -f "/etc/zsh/zprofile" && "$KON_LOGIN_SHELL" == "1" ]] ; then
    source "/etc/zsh/zprofile"
fi

if [[ -f "${_KON_USER_ZDOTDIR:-$HOME}/.zprofile" && "$KON_LOGIN_SHELL" == "1" ]] ; then
    source "${_KON_USER_ZDOTDIR:-$HOME}/.zprofile"
fi

if [[ -f "/etc/zshrc" ]] ; then
    source "/etc/zshrc"
elif [[ -f "/etc/zsh/zshrc" ]] ; then
    source "/etc/zsh/zshrc"
fi

if [[ -f "${_KON_USER_ZDOTDIR:-$HOME}/.zshrc" ]] ; then
    ZDOTDIR=$_KON_USER_ZDOTDIR \
        source "${_KON_USER_ZDOTDIR:-$HOME}/.zshrc"
fi

if [[ -f "/etc/zlogin" && "$KON_LOGIN_SHELL" == "1" ]] ; then
    source "/etc/zlogin"
elif [[ -f "/etc/zsh/zlogin" && "$KON_LOGIN_SHELL" == "1" ]] ; then
    source "/etc/zsh/zlogin"
fi

if [[ -f "${_KON_USER_ZDOTDIR:-$HOME}/.zlogin" && "$KON_LOGIN_SHELL" == "1" ]] ; then
    source "${_KON_USER_ZDOTDIR:-$HOME}/.zlogin"
fi

unset _KON_USER_ZDOTDIR

autoload -Uz add-zsh-hook

# This function sets the proper KUBECONFIG variable before a command runs,
# in case something overwrote it.
function __kubie_cmd_pre_exec__() {
    export KUBECONFIG="$KON_KUBECONFIG"
}

add-zsh-hook preexec __kubie_cmd_pre_exec__

# Activate prompt substitution.
setopt PROMPT_SUBST

# This function fixes the prompt via a precmd hook.
function __kubie_cmd_pre_cmd__() {
    local KON_PROMPT=$'[%{\e[31m%}$(/usr/local/bin/kon info ctx)%{\e[0m%}|%{\e[32m%}$(/usr/local/bin/kon info ns)%{\e[0m%}|%{\e[34m%}4%{\e[0m%}]'

    # If KON_ZSH_USE_RPS1 is set, we use RPS1 instead of PS1.
    if [[ "$KON_ZSH_USE_RPS1" == "1" ]] ; then

        # Avoid modifying RPS1 again if the RPS1 has not been reset.
        if [[ "$RPS1" != *"$KON_PROMPT"* ]] ; then

            # If RPS1 is empty, we do not seperate with a space.
            if [[ -z "$RPS1" ]] ; then
                RPS1="$KON_PROMPT"
            else
                RPS1="$KON_PROMPT $RPS1"
            fi
        fi
    else
        # Avoid modifying PS1 again if the PS1 has not been reset.
        if [[ "$PS1" != *"$KON_PROMPT"* ]] ; then
            PS1="$KON_PROMPT $PS1"
        fi
    fi
}

# When promptinit is activated, a precmd hook which updates PS1 is installed.
# In order to inject the kubie PS1 when promptinit is activated, we must
# also add our own precmd hook which modifies PS1 after promptinit themes.
add-zsh-hook precmd __kubie_cmd_pre_cmd__
