=== env ===
KUBECONFIG=/tmp/kubie-test/kubeconfig
KON_ACTIVE=1
KON_DEPTH=4
KON_KUBECONFIG=/tmp/kubie-test/kubeconfig
KON_KUBE_CONFIG=/tmp/kubie-test/kubeconfig
KON_SESSION=/tmp/kubie-test/session.json
KON_STATE=/tmp/kubie-test/state.json
KON_PROMPT_DISABLE=0
KON_ZSH_USE_RPS1=0
KON_FISH_USE_RPROMPT=0
KON_XONSH_USE_RIGHT_PROMPT=0
KON_SHELL=fish
KUBIE_ACTIVE=1
KUBIE_DEPTH=4
KUBIE_KUBECONFIG=/tmp/kubie-test/kubeconfig
KUBIE_SESSION=/tmp/kubie-test/session.json
KUBIE_STATE=/tmp/kubie-test/state.json
KUBIE_PROMPT_DISABLE=0
KUBIE_ZSH_USE_RPS1=0
KUBIE_FISH_USE_RPROMPT=0
KUBIE_XONSH_USE_RIGHT_PROMPT=0
KUBIE_SHELL=fish
=== rc ===

# Set the proper KUBECONFIG variable before each command runs,
# to prevent the user from overwriting it.
function kubie_preexec --on-event fish_preexec
    set -xg KUBECONFIG "$KON_KUBECONFIG"
end

if test "$KON_PROMPT_DISABLE" = "0"
    # The general idea behind the prompt substitions is to save the existing
    # prompt's output _before_ anything else is run. This is important since the
    # existing prompt might be dependent on say the status of the executed command.

    if test "$KON_FISH_USE_RPROMPT" = "1"
        functions -q fish_right_prompt
        and functions --copy fish_right_prompt fish_right_prompt_original
        or function fish_right_prompt_original; end

        function fish_right_prompt
            set -l original (fish_right_prompt_original)

            # Fish's right prompt does not support newlines, so there's no point in
            # iterating through the (potentially) existing prompt's lines.
            printf '%s %s' (string unescape [\e[31m(/usr/local/bin/kon info ctx)\e[0m|\e[32m(/usr/local/bin/kon info ns)\e[0m|\e[34m4\e[0m]) $original
        end
    else
        functions --copy fish_prompt fish_prompt_original
        function fish_prompt
            set -l original (fish_prompt_original)

            printf '%s ' (string unescape [\e[31m(/usr/local/bin/kon info ctx)\e[0m|\e[32m(/usr/local/bin/kon info ns)\e[0m|\e[34m4\e[0m])

            # Due to idiosyncrasies with the way fish is managing newlines in
            # process substitions, each line needs to be printed separately
            # to mirror the existing output. For more details,
            # see https://github.com/fish-shell/fish-shell/issues/159.
            for line in $original
                echo -e $line
            end
        end
    end
end
    