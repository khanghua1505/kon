apiVersion: v1
kind: Config
current-context: beta-dev
clusters:
    - name: beta-cluster
      cluster:
        server: https://beta.example.com:6443
        certificate-authority: <SOURCE_DIR>/certs/beta-ca.crt
        tls-server-name: beta.internal
contexts:
    - name: beta-dev
      context:
        cluster: beta-cluster
        user: beta-user
users:
    - name: beta-user
      user:
        exec:
            apiVersion: client.authentication.k8s.io/v1beta1
            command: aws
            args:
                - eks
                - get-token
                - --cluster-name
                - beta
            env:
                - name: AWS_PROFILE
                  value: beta
